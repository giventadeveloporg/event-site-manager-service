<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260918120000-1" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="last_matches" columnName="match_kind"/>
            </not>
        </preConditions>
        <addColumn tableName="last_matches">
            <column name="match_kind" type="varchar(32)" defaultValue="PAST">
                <constraints nullable="false"/>
            </column>
        </addColumn>
        <createIndex indexName="idx_last_matches_match_kind" tableName="last_matches">
            <column name="match_kind"/>
        </createIndex>
        <sql>UPDATE last_matches SET match_kind = 'PAST' WHERE match_kind IS NULL OR match_kind = '';</sql>
    </changeSet>
</databaseChangeLog>
