<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="20260928120000-1" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <sequenceExists sequenceName="homepage_youtube_override_id_seq" schemaName="public"/>
            </not>
        </preConditions>
        <createSequence
            sequenceName="homepage_youtube_override_id_seq"
            schemaName="public"
            startValue="1"
            incrementBy="1"
            minValue="1"
            cycle="false"/>
    </changeSet>

    <changeSet id="20260928120000-2" author="system">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="homepage_youtube_override"/>
            </not>
        </preConditions>
        <createTable tableName="homepage_youtube_override">
            <column name="id" type="bigint">
                <constraints primaryKey="true" nullable="false" primaryKeyName="homepage_youtube_override_pkey"/>
            </column>
            <column name="tenant_id" type="varchar(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="ux_homepage_youtube_override_tenant_id"/>
            </column>
            <column name="youtube_url" type="varchar(1024)"/>
            <column name="title" type="varchar(500)"/>
            <column name="description" type="text"/>
            <column name="is_active" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
            <column name="starts_at" type="${datetimeType}"/>
            <column name="ends_at" type="${datetimeType}"/>
            <column name="created_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="${datetimeType}">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <createIndex indexName="idx_homepage_youtube_override_tenant_id" tableName="homepage_youtube_override">
            <column name="tenant_id"/>
        </createIndex>
        <createIndex indexName="idx_homepage_youtube_override_is_active" tableName="homepage_youtube_override">
            <column name="tenant_id"/>
            <column name="is_active"/>
        </createIndex>
        <sql dbms="postgresql">
            CREATE TRIGGER trg_homepage_youtube_override_updated_at
                BEFORE UPDATE ON public.homepage_youtube_override
                FOR EACH ROW
                EXECUTE FUNCTION public.update_updated_at_column();
        </sql>
    </changeSet>
</databaseChangeLog>
