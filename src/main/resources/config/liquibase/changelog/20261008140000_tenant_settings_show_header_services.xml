<?xml version="1.0" encoding="utf-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Header menu: Services, independent of show_profile_services_section (homepage cards). -->
    <changeSet id="20261008140000-1" author="system" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <tableExists tableName="tenant_settings"/>
            <not>
                <columnExists tableName="tenant_settings" columnName="show_header_services"/>
            </not>
        </preConditions>
        <sql><![CDATA[
            ALTER TABLE public.tenant_settings
                ADD COLUMN IF NOT EXISTS show_header_services boolean;

            COMMENT ON COLUMN public.tenant_settings.show_header_services IS
                'When true, public header shows Services (professional services catalog). Null uses app default OFF.';
        ]]></sql>
    </changeSet>

    <changeSet id="20261008140000-2" author="system" dbms="postgresql">
        <preConditions onFail="MARK_RAN">
            <columnExists tableName="tenant_settings" columnName="show_header_services"/>
            <columnExists tableName="tenant_settings" columnName="show_profile_services_section"/>
        </preConditions>
        <sql><![CDATA[
            UPDATE public.tenant_settings
               SET show_header_services = show_profile_services_section
             WHERE show_header_services IS NULL;
        ]]></sql>
    </changeSet>
</databaseChangeLog>
